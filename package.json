{
  "name": "keyseal",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --filter @keyseal/server build",
    "check:types": "bun run --filter '*' check:types",
    "format": "bunx oxfmt .",
    "format:check": "bunx oxfmt --check .",
    "lint": "bunx oxlint . --max-warnings=0",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.4"
}
