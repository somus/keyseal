{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KeySeal driver catalogue",
  "description": "Maps USB ids of DSC tokens to PKCS#11 module paths per platform. Vendor and product id pairs must be unique across all tokens; JSON Schema cannot express that, so the catalogue tools check it separately.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "generatedAt", "tokens"],
  "properties": {
    "$schema": { "type": "string" },
    "version": {
      "description": "Monotonic. The helper refuses a catalogue whose version is lower than the one it already holds.",
      "type": "integer",
      "minimum": 1
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "tokens": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/token" }
    }
  },
  "$defs": {
    "token": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "vendor", "usb", "modules"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "vendor": { "type": "string", "minLength": 1 },
        "usb": {
          "description": "Empty when no public source states the ids. Never guessed.",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/usbId" }
        },
        "modules": {
          "description": "Candidate module paths per platform, tried in order.",
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "macos-arm64": { "$ref": "#/$defs/posixPaths" },
            "macos-x64": { "$ref": "#/$defs/posixPaths" },
            "linux-x64": { "$ref": "#/$defs/posixPaths" },
            "windows-x64": { "$ref": "#/$defs/windowsPaths" }
          }
        },
        "notes": { "type": "string" },
        "cng": {
          "description": "Windows token known to work only through CNG, not PKCS#11.",
          "const": true
        }
      }
    },
    "usbId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vid", "pid"],
      "properties": {
        "vid": { "$ref": "#/$defs/hex16" },
        "pid": { "$ref": "#/$defs/hex16" }
      }
    },
    "hex16": { "type": "string", "pattern": "^[0-9a-f]{4}$" },
    "posixPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?!.*/\\.{1,2}(?:/|$))(?!.*//)/(?:usr/local/lib|usr/lib|usr/lib64|Library|opt|Applications)/[^\\u0000]+[^/]$"
      }
    },
    "windowsPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?!.*\\\\\\.{1,2}(?:\\\\|$))(?!.*\\\\\\\\)C:\\\\(?:Windows\\\\System32|Program Files|Program Files \\(x86\\))\\\\[^/:*?\"<>|\\u0000]+[^\\\\]$"
      }
    }
  }
}
